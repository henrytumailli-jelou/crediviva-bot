    {
      "id": "tsVobzPBjdrLFlIBQovth",
      "title": "Asistente: comprobante de último pago",
      "configuration": {
        "name": "Asistente comprobante de último pago",
        "model": "openai/gpt-6-luna",
        "version": "v2",
