    {
      "id": "GhARoZy9xdrelGi7Lw_Jn",
      "title": "Interpretar decisión",
      "configuration": {
        "title": "Interpretar decisión",
        "content": "const res = $context.getHttpResponse(\"consEstadoResp\");\nlet status = 0;\ntry {\n  status = Number(typeof res?.status === \"function\" ? res.status() : res?.status) || 0;\n} catch (e) {\n  status = 0;\n}\nlet data = {};\ntry {\n  data = typeof res?.json === \"function\" ? await res.json() : (res?.json ?? res?.data ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nif (!data || typeof data !== \"object\") data = {};\nconst ok = status >= 200 && status < 300;\n$utils.logger.log(\"consEstadoResp\", JSON.stringify({ status, estado: data.estado }));\n// La decisión se toma de Datum (la guardó la Function), no del callback de la página.\nconst rondas = Number($memory.get(\"cv_consRondas\", 0)) + 1;\n$memory.set(\"cv_consRondas\", rondas);\nlet siguiente = \"error\";\nif (ok && data.estado === \"aceptado\") siguiente = \"aceptado\";\nelse if (ok && data.estado === \"rechazado\") siguiente = \"rechazado\";\nelse if (ok && data.estado === \"sin_registro\") siguiente = rondas >= 2 ? \"agotado\" : \"reintentar\";\n$memory.set(\"cv_consDecision\", siguiente);",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        3224,
        315
      ]
