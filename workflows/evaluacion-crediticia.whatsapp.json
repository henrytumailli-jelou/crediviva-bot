    {
      "id": "M9O4PMVwnjzTND-uzCLsb",
      "title": "Revisar sesión",
      "configuration": {
        "title": "Revisar sesión",
        "content": "// Sesión de Crediviva que dejó el registro en memoria (vence a los 30 min).\nconst s = $memory.getJson(\"cv_sesionCrediviva\", null);\nconst vigente = !!(s && s.authKey && s.ambiente === $memory.get(\"cv_ambiente\", \"\"));\n$memory.set(\"cv_sesionVigente\", vigente ? \"si\" : \"no\");\n// Decisión final ya conocida: se muestra sin volver a pedir nada.\nlet previa = $memory.get(\"cv_evaluacion\", \"\");\n// Si el login dice que el pendiente ya es la solicitud, el ingreso fue aprobado: se va directo al formulario.\nconst paso = String($memory.get(\"cv_pasoCrediviva\", \"\")).toLowerCase();\nif (!previa && vigente && paso.startsWith(\"credit-application\")) previa = \"approved\";\n// Atajo de pruebas (solo lo marca Registro para números de prueba en staging): directo al formulario.\nif (!previa && vigente && $memory.get(\"cv_pruebaSolicitud\", \"\") === \"si\") previa = \"approved\";\n// Borrar y escribir la misma clave en un mismo nodo no es confiable (el borrado puede aplicarse\n// después y dejarla vacía): se escribe si hay decisión y solo se borra si no la hay.\nif (previa) $memory.setJson(\"cv_eval\", { estado: previa }, 3600);\nelse $memory.delete(\"cv_eval\");\n$memory.set(\"cv_evalPrevia\", previa ? \"si\" : \"no\");",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        1264,
        75
      ]
    },
    {
      "id": "mSWei534i0Ox0NsYT6llm",
      "title": "Guardar resultado",
      "configuration": {
        "title": "Guardar resultado",
        "content": "const r = $memory.getJson(\"cv_eval\", {});\n$memory.set(\"cv_ultimoResultado\", \"evaluacion_\" + String(r.estado || \"\"));\n// Rechazo o revisión manual por ingreso son definitivos. Aprobado sigue con la solicitud, cuya\n// decisión es la final. \"completado\" (el ingreso ya estaba registrado, sin decisión a la vista)\n// también sigue a la solicitud: Crediviva salta los pasos hechos y devuelve la decisión.\nconst e = String(r.estado || \"\");\nif (e === \"rejected\" || e === \"manualAnalysis\") $memory.set(\"cv_evaluacion\", e);\nelse if (e === \"completado\" && !$memory.get(\"cv_evaluacion\", \"\")) $memory.setJson(\"cv_eval\", { estado: \"approved\" }, 3600);",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        2428,
        50
      ]
