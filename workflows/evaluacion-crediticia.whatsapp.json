    {
      "id": "DbVWyHH_OKYW6u5ccQ1c6",
      "title": "Leer decisión",
      "configuration": {
        "title": "Leer decisión",
        "content": "// Cómo terminó el formulario de solicitud (la Function lo deja en Datum y la tool lo entrega una vez).\nconst r = $memory.getJson(\"cv_solRes\", {}) || {};\n$memory.delete(\"cv_solRes\");\nconst dec = String(r.decision || \"\").toUpperCase();\nlet estado = \"error\";\nif (r.estado === \"completado\" && r.origen === \"solicitud\") {\n  estado = dec === \"APPROVED\" ? \"credito_aprobado\" : dec === \"REJECTED\" ? \"rejected\" : dec === \"PENDING\" ? \"manualAnalysis\" : \"completado\";\n} else if (r.estado === \"cancelado\" || r.estado === \"pendiente\") estado = \"cancelado\";\nelse if (r.estado === \"sin_sesion\") estado = \"sin_sesion\";\n$memory.setJson(\"cv_eval\", { estado }, 3600);\nif ([\"credito_aprobado\", \"rejected\", \"manualAnalysis\"].includes(estado)) $memory.set(\"cv_evaluacion\", estado);\nif (estado === \"credito_aprobado\") {\n  const msg = String(r.mensaje || \"\").trim();\n  $memory.set(\"cv_solMensaje\", (msg || \"¡Felicitaciones! Tu crédito fue aprobado. Ingresa a la App de Crediviva con tu correo y contraseña para usarlo 📲\").slice(0, 1000));\n}",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
