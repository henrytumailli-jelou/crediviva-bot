        "content": "// Atajo de pruebas: sesión de Crediviva sin formulario. La contraseña y la respuesta se borran de memoria.\nconst r = $memory.getJson(\"cv_pruebaLogin\", {}) || {};\n$memory.delete(\"cv_pruebaLogin\");\n$memory.delete(\"cv_pruebaClave\");\n$memory.delete(\"cv_pruebaCorreo\");\nlet estado = String(r.estado || \"error\");\n// Proceso ya terminado en Crediviva: no acepta más pasos (responde 401); se muestra el resultado.\nif (estado === \"completado\") $memory.set(\"cv_pruebaDecision\", String(r.decision || \"sin decisión\"), 600);\nif (r.authKey && estado === \"sesion_iniciada\") {\n  $memory.setJson(\"cv_sesionCrediviva\", { authKey: r.authKey, origen: \"login\", ambiente: $memory.get(\"cv_ambiente\", \"\") }, 1800);\n  $memory.set(\"cv_pasoCrediviva\", String(r.paso || \"\"), 1800);\n  // Sin celular ni KYC: Evaluación no vuelve a mandar a la verificación de identidad.\n  $memory.set(\"cv_kycAprobado\", \"si\", 3600);\n  // Y sin ingreso: Evaluación lo manda directo al formulario de solicitud.\n  $memory.set(\"cv_pruebaSolicitud\", \"si\", 3600);\n  estado = \"ok\";\n}\n$memory.set(\"cv_pruebaEstado\", estado, 600);",
        "memoryVersion": "v2"
      },
