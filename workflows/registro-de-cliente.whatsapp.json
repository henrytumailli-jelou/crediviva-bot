    {
      "id": "jO10-vDhqLvyZB9FQ_zXC",
      "title": "Guardar sesión",
      "configuration": {
        "title": "Guardar sesión",
        "content": "// Cómo terminó el webview, entregado por la Function una sola vez. La sesión de Crediviva\n// (authKey) queda en memoria 30 min: Crediviva la invalida antes de 24 h (se vio un 401 a ~1 h 40 min)\n// y una sesión vencida haría saltar el login. La copia de la tool se borra.\nconst r = $memory.getJson(\"cv_recogida\", {}) || {};\n$memory.delete(\"cv_recogida\");\nconst estado = String(r.estado || \"pendiente\");\nif (r.authKey) {\n  $memory.setJson(\"cv_sesionCrediviva\", { authKey: r.authKey, origen: r.origen || \"\", ambiente: r.ambiente || $memory.get(\"cv_ambiente\", \"\") }, 1800);\n}\n// Paso pendiente en Crediviva (lo devuelve el login): Verificación y Evaluación saltan lo ya hecho.\n$memory.set(\"cv_pasoCrediviva\", String(r.paso || \"\"), 1800);\n$memory.setJson(\"cv_registroResultado\", { estado, paso: r.paso || \"\", decision: r.decision || \"\" }, 86400);",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        3204,
        1300
      ]
    },
