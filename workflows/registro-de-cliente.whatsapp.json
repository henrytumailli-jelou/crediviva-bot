      "id": "D8DBcMGlgC5Eo61L_X5SL",
      "title": "Preparar asistente",
      "configuration": {
        "title": "Preparar asistente",
        "content": "// Al volver del webview el agente sale sin estado; se limpian los de una vuelta anterior.\n$memory.delete(\"cv_registro\");\n$memory.delete(\"cv_registroResultado\");\n// Sesión de Crediviva vigente (la escribe la Function al crear la cuenta o iniciar sesión; dura 24 h).\nconst s = $memory.getJson(\"cv_sesionCrediviva\", null);\nconst vigente = !!(s && s.authKey && s.ambiente === $memory.get(\"cv_ambiente\", \"\"));\n$memory.set(\"cv_sesionVigente\", vigente ? \"si\" : \"no\");",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        1652,
        50
      ]
