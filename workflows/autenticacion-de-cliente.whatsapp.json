      "configuration": {
        "content": "const r = $memory.getJson(\"cv_res\", {});\nconst motivo = String(r.reason || \"incomplete\");\nif (motivo === \"blocked\") {\n  $memory.set(\"cv_bloqueadoHasta\", Date.now() + 30 * 60 * 1000);\n}\nconst rondas = Number($memory.get(\"cv_rondasWv\", 0)) + 1;\n$memory.set(\"cv_rondasWv\", rondas);\n$memory.set(\"cv_motivo\", motivo === \"blocked\" ? \"bloqueado\" : rondas >= 3 ? \"agotado\" : \"reintentar\");",
