    {
      "id": "t1BDa16qy4_Kc7QZBdqJo",
      "title": "Validar teléfono compartido",
      "configuration": {
        "title": "Validar teléfono compartido",
        "content": "// Meta entrega el número sin formato garantizado (+507 6123-4567, 50761234567, 61234567…).\nfunction normalizarTelefono(raw) {\n  let d = String(raw || \"\").replace(/\\D/g, \"\");\n  if (d.startsWith(\"00\")) d = d.slice(2);\n  if (d.length === 11 && d.startsWith(\"507\")) return { phone: d.slice(3), pais: \"PA\" };\n  if (d.length === 8) return { phone: d, pais: \"PA\" };\n  if (d.length >= 7 && d.length <= 15) return { phone: d, pais: \"OTRO\" };\n  return null;\n}\nconst raw = String($memory.get(\"cv_userPhone\", \"\"));\nconst tel = normalizarTelefono(raw);\n$utils.logger.log(\"contacto compartido\", JSON.stringify({ digitos: String(raw).replace(/\\D/g, \"\").length, pais: tel ? tel.pais : null }));\nlet estado;\nif (tel) {\n  $memory.set(\"cv_phone\", tel.phone);\n  $memory.set(\"cv_phoneSource\", \"shared_contact\");\n  estado = \"ok\";\n} else {\n  const n = Number($memory.get(\"cv_intentosTel\", 0)) + 1;\n  $memory.set(\"cv_intentosTel\", n);\n  estado = n >= 2 ? \"agotado\" : \"reintentar\";\n}\n$memory.set(\"cv_contactoEstado\", estado);\n",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        2836,
        65
      ]
