    {
      "id": "YdCHJoUaQoLhSuoPk1vUV",
      "title": "Revisar sesión vigente",
      "configuration": {
        "title": "Revisar sesión vigente",
        "content": "// Meta entrega el número sin formato garantizado (+507 6123-4567, 50761234567, 61234567…).\nfunction normalizarTelefono(raw) {\n  let d = String(raw || \"\").replace(/\\D/g, \"\");\n  if (d.startsWith(\"00\")) d = d.slice(2);\n  if (d.length === 11 && d.startsWith(\"507\")) return { phone: d.slice(3), pais: \"PA\" };\n  if (d.length === 8) return { phone: d, pais: \"PA\" };\n  if (d.length >= 7 && d.length <= 15) return { phone: d, pais: \"OTRO\" };\n  return null;\n}\nconst ahora = Date.now();\nconst ambiente = $memory.get(\"cv_ambiente\", \"staging\");\nconst sesion = $memory.getJson(\"cv_sesion\", null);\nlet estado;\nif (sesion && sesion.token && Number(sesion.expira) > ahora && sesion.ambiente === ambiente) {\n  estado = \"vigente\";\n} else if (Number($memory.get(\"cv_bloqueadoHasta\", 0)) > ahora) {\n  estado = \"bloqueado\";\n} else {\n  const tel = normalizarTelefono($memory.get(\"cv_userPhone\", \"\"));\n  if (tel) {\n    $memory.set(\"cv_phone\", tel.phone);\n    $memory.set(\"cv_phoneSource\", \"user_phone\");\n    estado = \"con_telefono\";\n  } else {\n    estado = \"pedir_contacto\";\n  }\n  $memory.set(\"cv_intentosTel\", 0);\n  $memory.set(\"cv_rondasWv\", 0);\n}\n$memory.set(\"cv_authEstado\", estado);",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        1264,
        50
      ]
    }
  ],
