    {
      "id": "cmYk9u69r6fwbJtO4prvI",
      "title": "Leer respuesta del webview",
      "configuration": {
        "content": "// La plataforma guarda el data del callback del webview en cv_wvResp; su forma exacta\n// puede venir anidada o serializada, así que se buscan las variantes conocidas.\nfunction leer(clave) {\n  let v = null;\n  try { v = $memory.getJson(clave, null); } catch (e) { v = null; }\n  if (v === null) {\n    try { v = $memory.get(clave, null); } catch (e) { v = null; }\n  }\n  if (typeof v === \"string\") {\n    try { v = JSON.parse(v); } catch (e) { /* queda como texto */ }\n  }\n  return v;\n}\nfunction buscarSello(v, prof) {\n  if (!v || prof > 4) return \"\";\n  if (typeof v === \"string\") return v.length >= 40 && /^[A-Za-z0-9_-]+$/.test(v) ? v : \"\";\n  if (typeof v !== \"object\") return \"\";\n  if (typeof v.n === \"string\" && v.n.length >= 40) return v.n;\n  for (const k of [\"data\", \"response\", \"payload\", \"body\", \"result\"]) {\n    const s = buscarSello(v[k], prof + 1);\n    if (s) return s;\n  }\n  return \"\";\n}\nfunction forma(v, prof) {\n  if (v === null || v === undefined) return String(v);\n  if (typeof v !== \"object\") return typeof v + (typeof v === \"string\" ? \"(\" + v.length + \")\" : \"\");\n  if (prof > 2) return \"{…}\";\n  return \"{\" + Object.keys(v).map((k) => k + \":\" + forma(v[k], prof + 1)).join(\",\") + \"}\";\n}\nlet sello = \"\";\nfor (const clave of [\"cv_wvResp\", \"response\"]) {\n  const v = leer(clave);\n  $utils.logger.log(\"webview \" + clave, forma(v, 0));\n  sello = buscarSello(v, 0);\n  if (sello) break;\n}\n$memory.set(\"cv_wvSello\", sello);",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        5204,
        695
      ]
