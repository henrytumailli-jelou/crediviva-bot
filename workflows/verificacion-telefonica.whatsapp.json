    {
      "id": "c0S8fcFSbYhzFKf2x9trp",
      "title": "Validar formato del teléfono",
      "configuration": {
        "title": "Validar formato del teléfono",
        "content": "let digits = String($memory.get('phoneRaw', '')).replace(/\\D/g, '');\nif (digits.length === 11 && digits.startsWith('507')) digits = digits.slice(3);\nconst max = Number($memory.get('maxAttempts', 3));\nif (/^6\\d{7}$/.test(digits)) {\n  $memory.set('phone', digits);\n  $memory.set('phoneMasked', '****' + digits.slice(-4));\n  $memory.set('phoneStatus', 'valid');\n} else {\n  const attempts = Number($memory.get('phoneAttempts', 0)) + 1;\n  $memory.set('phoneAttempts', attempts);\n  $memory.set('phoneStatus', attempts >= max ? 'exhausted' : 'invalid');\n}",
        "memoryVersion": "v2"
      },
