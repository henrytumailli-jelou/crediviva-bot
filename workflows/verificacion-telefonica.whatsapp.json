        "content": "const res = $context.getHttpResponse('verifyPhoneResponse');\nlet data = {};\ntry {\n  data = (res && typeof res.json === 'function') ? await res.json() : (res?.data ?? res?.body ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === 'string') {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nconst status = Number(res?.status ?? res?.statusCode ?? 200);\nconst ok = status >= 200 && status < 300;\n$utils.logger.log('verifyPhoneResponse', JSON.stringify({ status, data }));\nconst authType = Number(data?.authType);\nlet check = 'error';\nif (ok && authType === 1) check = 'registered';\nelse if (ok && authType === 2) check = 'new';\n$memory.set('phoneCheck', check);",
