    {
      "id": "ey-5KzoF8O6tmf3NOwZaP",
      "title": "Interpretar verificación del código",
      "configuration": {
        "title": "Interpretar verificación del código",
        "content": "const res = $context.getHttpResponse('verifyPhoneOtpResponse');\nlet data = {};\ntry {\n  data = (res && typeof res.json === 'function') ? await res.json() : (res?.data ?? res?.body ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === 'string') {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nconst status = Number(res?.status ?? res?.statusCode ?? 200);\nconst ok = status >= 200 && status < 300;\n$utils.logger.log('verifyPhoneOtpResponse', JSON.stringify({ status, data }));\nconst max = Number($memory.get('maxAttempts', 3));\nconst flags = [data?.otpValid, data?.valid, data?.verified, data?.success];\nconst valid = ok && flags.some((f) => f === true);\nlet result;\nif (valid) {\n  $memory.set('phoneVerified', true);\n  result = 'valid';\n} else if (ok || status === 400 || status === 401 || status === 422) {\n  const attempts = Number($memory.get('otpAttempts', 0)) + 1;\n  $memory.set('otpAttempts', attempts);\n  result = attempts >= max ? 'exhausted' : 'invalid';\n} else {\n  result = 'error';\n}\n$memory.set('otpResult', result);",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
