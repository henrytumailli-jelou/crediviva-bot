    {
      "id": "1l8GLUsEPxN4TrtoqX_wA",
      "title": "Revisar respuesta del código",
      "configuration": {
        "title": "Revisar respuesta del código",
        "content": "const raw = String($memory.get('otpRaw', '')).trim();\nconst max = Number($memory.get('maxAttempts', 3));\nlet action;\nif (/^reenviar$/i.test(raw) || /^reenv/i.test(raw)) {\n  const resends = Number($memory.get('otpResends', 0)) + 1;\n  $memory.set('otpResends', resends);\n  action = resends > max ? 'exhausted' : 'resend';\n} else {\n  const otp = raw.replace(/\\s/g, '');\n  if (/^\\d{4,6}$/.test(otp)) {\n    $memory.set('otp', otp);\n    action = 'verify';\n  } else {\n    const attempts = Number($memory.get('otpAttempts', 0)) + 1;\n    $memory.set('otpAttempts', attempts);\n    action = attempts >= max ? 'exhausted' : 'invalid';\n  }\n}\n$memory.set('otpAction', action);",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        5612,
        50
      ]
    },
    {
      "id": "57NYx0rHSI3uxGmFdctyk",
      "title": "Interpretar envío del código",
      "configuration": {
        "title": "Interpretar envío del código",
        "content": "const res = $context.getHttpResponse('sendPhoneOtpResponse');\nlet data = {};\ntry {\n  data = (res && typeof res.json === 'function') ? await res.json() : (res?.data ?? res?.body ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === 'string') {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nconst status = Number(res?.status ?? res?.statusCode ?? 200);\nconst ok = status >= 200 && status < 300;\n$utils.logger.log('sendPhoneOtpResponse', JSON.stringify({ status, data }));\n$memory.set('otpSendStatus', ok ? 'sent' : 'error');",
        "memoryVersion": "v2"
      },
