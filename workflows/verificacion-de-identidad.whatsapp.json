    {
      "id": "R0j86ytsweum24FHdAFFL",
      "title": "Leer resultado",
      "configuration": {
        "title": "Leer resultado",
        "content": "// Resultado de Crediviva -> cv_kycPaso: esperar | preguntar | reintentar | fin (cv_kyc.estado).\nconst MAX_REINTENTOS = 2;\nconst n = (k) => Number($memory.get(k, 0)) || 0;\nconst terminar = (estado) => {\n  $memory.setJson(\"cv_kyc\", { estado }, 3600);\n  $memory.set(\"cv_kycPaso\", \"fin\");\n  // Crediviva ya la dio por buena: no se vuelve a pedir la biometría durante 1 hora.\n  if (estado === \"aprobado\") $memory.set(\"cv_kycAprobado\", \"si\", 3600);\n};\nconst reintentar = (prov, reintento) => {\n  if (n(\"cv_kycReintentos\") >= MAX_REINTENTOS) return terminar(\"asesor\");\n  $memory.set(\"cv_kycReintentos\", n(\"cv_kycReintentos\") + 1);\n  $memory.set(\"cv_kycProveedor\", prov);\n  $memory.set(\"cv_kycReintento\", reintento ? \"true\" : \"false\");\n  $memory.set(\"cv_kycPaso\", \"reintentar\");\n};\nconst otro = (p) => (p === \"VERIFF\" ? \"JUMIO\" : \"VERIFF\");\nconst proveedor = $memory.get(\"cv_kycProveedor\", \"\");\nconst directo = { cliente_existente: 1, sin_sesion: 1, app: 1, cancelado: 1 };\nconst MAX_CHEQUEOS = 5;\nconst r = $memory.getJson(\"cv_kycRes\", {}) || {};\n$memory.delete(\"cv_kycRes\");\nconst e = String(r.estado || \"error\");\nconst esperar = () => {\n  const c = n(\"cv_kycChequeos\") + 1;\n  $memory.set(\"cv_kycChequeos\", c);\n  $memory.set(\"cv_kycPaso\", c < MAX_CHEQUEOS ? \"esperar\" : \"preguntar\");\n};\nif (e === \"aprobado\" || e === \"completado\") terminar(\"aprobado\");\nelse if (e === \"no_lista\" || e === \"sin_verificacion\") esperar();\nelse if (e === \"reintentar\" || e === \"sesion_invalida\") reintentar(proveedor || \"JUMIO\", true);\nelse if (e === \"bloqueado\") { if (r.alternativa) reintentar(otro(proveedor || \"JUMIO\"), false); else terminar(\"asesor\"); }\nelse if (directo[e]) terminar(e);\nelse if (n(\"cv_kycErrores\") < 2) { $memory.set(\"cv_kycErrores\", n(\"cv_kycErrores\") + 1); esperar(); }\nelse terminar(\"asesor\");",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        4776,
        2400
      ]
    },
