    {
      "id": "puzQHzr-iKWeEFimVxZqd",
      "title": "Preparar solicitud",
      "type": "CODE",
      "position": [
        520,
        50
      ],
      "configuration": {
        "title": "Preparar solicitud",
        "content": "function inp(k, d) {\n  try {\n    const v = $input.get(k);\n    return v === undefined || v === null || v === \"\" ? d : v;\n  } catch (e) {\n    return d;\n  }\n}\nlet fallo = \"\";\nconst ambiente = String(inp(\"ambiente\", \"\")).trim().toLowerCase();\nif (ambiente !== \"staging\" && ambiente !== \"production\") {\n  fallo = \"El ambiente debe ser staging o production (recibido: \" + ambiente + \").\";\n}\nconst userId = String(inp(\"userId\", \"\")).trim();\nif (!fallo && !userId) fallo = \"Falta el usuario.\";\nconst body = { userId, ambiente };\nconst botId = String(inp(\"botId\", \"\")).trim();\nif (botId && !botId.includes(\"{{\")) body.botId = botId;\nconst phone = String(inp(\"phone\", \"\")).trim();\nif (phone && !phone.includes(\"{{\")) body.phone = phone;\n$context.set(\"body\", JSON.stringify(body));\nif (fallo) $output.set(\"error\", { ok: false, code: \"CONFIGURACION\", message: fallo });\n$context.set(\"prepOk\", fallo ? \"no\" : \"si\");",
        "memoryVersion": "v2"
      }
    },
    {
      "id": "TiMUx2ELOMT1ZShO1wjmp",
      "title": "Fallo técnico",
      "type": "CODE",
      "position": [
        2200,
