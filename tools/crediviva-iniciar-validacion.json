    {
      "id": "iaECLEEpbsZvxxzQo3Gt5",
      "type": "CODE",
      "title": "Interpretar respuesta",
      "position": [
        1780,
        50
      ],
      "configuration": {
        "title": "Interpretar respuesta",
        "content": "const res = $context.getHttpResponse(\"iniciarResponse\");\nlet status = 0;\ntry {\n  status = Number(typeof res?.status === \"function\" ? res.status() : res?.status) || 0;\n} catch (e) {\n  status = 0;\n}\nlet data = {};\ntry {\n  data = typeof res?.json === \"function\" ? await res.json() : (res?.json ?? res?.data ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nif (!data || typeof data !== \"object\") data = {};\nconst ok = status >= 200 && status < 300;\nconst mensaje = String(data.message ?? data.error?.message ?? data.detail ?? \"\");\nconst codigo = String(data.code ?? data.errorCode ?? data.error?.code ?? (typeof data.error === \"string\" ? data.error : \"\"));\n$utils.logger.log(\"iniciarResponse\", JSON.stringify({ status, codigo }));\nlet salida = \"error\";\nif (ok && data.ok === true && typeof data.url === \"string\") {\n  salida = \"enlace\";\n  $output.set(\"enlace\", { ok: true, url: data.url, nonce: data.nonce, ttlSeconds: data.ttlSeconds });\n} else if (ok && data.status === \"blocked\") {\n  salida = \"bloqueado\";\n  $output.set(\"bloqueado\", { ok: false, minutesLeft: Number(data.minutesLeft || 30) });\n} else {\n  $output.set(\"error\", { ok: false, code: \"HTTP_\" + status, message: mensaje || \"No se pudo crear la sesión de validación.\" });\n}\n$context.set(\"salida\", salida);",
        "memoryVersion": "v2"
      }
    },
