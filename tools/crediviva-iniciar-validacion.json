    {
      "id": "QwRdaFtA-Dp7J6Ks0t41n",
      "type": "CODE",
      "title": "Preparar solicitud",
      "position": [
        520,
        50
      ],
      "configuration": {
        "title": "Preparar solicitud",
        "content": "function inp(k, d) {\n  try {\n    const v = $input.get(k);\n    return v === undefined || v === null || v === \"\" ? d : v;\n  } catch (e) {\n    return d;\n  }\n}\nasync function secreto(nombre) {\n  try {\n    return String((await $secret.get(nombre)) || \"\");\n  } catch (e) {\n    return \"\";\n  }\n}\nlet fallo = \"\";\nconst ambiente = String(inp(\"ambiente\", \"\")).trim().toLowerCase();\nif (ambiente !== \"staging\" && ambiente !== \"production\") {\n  fallo = \"El ambiente debe ser staging o production (recibido: \" + ambiente + \").\";\n}\nconst fnKey = (await secreto(\"JELOU_FN_INVOKE_KEY\"));\nif (!fallo && fnKey.length < 8) fallo = \"Falta el secreto JELOU_FN_INVOKE_KEY.\";\nlet phone = String(inp(\"phone\", \"\")).replace(/\\D/g, \"\");\nif (phone.length === 11 && phone.startsWith(\"507\")) phone = phone.slice(3);\nconst authType = Number(inp(\"authType\", 0));\nconst userId = String(inp(\"userId\", \"\")).trim();\nif (!fallo && !userId) fallo = \"Falta el usuario.\";\nif (!fallo && authType !== 1 && authType !== 2) fallo = \"Tipo de autenticación inválido.\";\nconst body = { userId, phone, countryCode: String(inp(\"countryCode\", \"PA\")).toUpperCase(), authType, ambiente };\nconst botId = String(inp(\"botId\", \"\")).trim();\nif (botId) body.botId = botId;\n$context.set(\"fnKey\", fnKey);\n$context.set(\"body\", JSON.stringify(body));\nif (fallo) {\n  $output.set(\"error\", { ok: false, code: \"CONFIGURACION\", message: fallo });\n}\n$context.set(\"prepOk\", fallo ? \"no\" : \"si\");",
        "memoryVersion": "v2"
      }
    }
