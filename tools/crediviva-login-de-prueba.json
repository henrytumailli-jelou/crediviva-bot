    {
      "id": "DEdZ5aodfuvXtdvZ24H-M",
      "title": "Preparar solicitud",
      "type": "CODE",
      "position": [
        520,
        50
      ],
      "configuration": {
        "title": "Preparar solicitud",
        "content": "function inp(k, d) {\n  try {\n    const v = $input.get(k);\n    return v === undefined || v === null || v === \"\" ? d : v;\n  } catch (e) {\n    return d;\n  }\n}\nlet fallo = \"\";\nconst ambiente = String(inp(\"ambiente\", \"\")).trim().toLowerCase();\nif (ambiente !== \"staging\" && ambiente !== \"production\") fallo = \"El ambiente debe ser staging o production (recibido: \" + ambiente + \").\";\nconst userId = String(inp(\"userId\", \"\")).trim();\nconst email = String(inp(\"email\", \"\")).trim().toLowerCase();\n// La contraseña nunca se imprime.\nconst password = String(inp(\"password\", \"\"));\nif (!fallo && (!userId || !email || !password)) fallo = \"Faltan datos para iniciar sesión.\";\n$context.set(\"body\", JSON.stringify({ userId, email, password, ambiente }));\nif (fallo) $output.set(\"error\", { ok: false, estado: \"error\", code: \"CONFIGURACION\", message: fallo });\n$context.set(\"prepOk\", fallo ? \"no\" : \"si\");",
        "memoryVersion": "v2"
      }
    },
    {
      "id": "IHOqrjDkf7ElmlLJOLsjv",
      "title": "¿Solicitud lista?",
      "type": "CONDITIONAL",
      "position": [
        940,
        50
      ],
      "configuration": {
        "title": "¿Solicitud lista?",
        "conditions": [
          {
            "id": "cond_prep_ok",
            "name": "Lista para enviar",
            "operator": "and",
            "terms": [
              {
                "value1": "{{$context.prepOk}}",
                "operator": "equal",
                "value2": "si"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "jMolhx59F90K_I3PFAf74",
      "title": "Interpretar respuesta",
      "type": "CODE",
      "position": [
        1780,
        50
      ],
      "configuration": {
        "title": "Interpretar respuesta",
        "content": "const res = $context.getHttpResponse(\"fnResponse\");\nlet status = 0;\ntry {\n  status = Number(typeof res?.status === \"function\" ? res.status() : res?.status) || 0;\n} catch (e) {\n  status = 0;\n}\nlet data = {};\ntry {\n  data = typeof res?.json === \"function\" ? await res.json() : (res?.json ?? res?.data ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nif (!data || typeof data !== \"object\") data = {};\nconst ok = status >= 200 && status < 300;\n$utils.logger.log(\"fnResponse\", JSON.stringify({ status, estado: data.estado }));\nlet salida = \"error\";\nconst conocidos = [\"sesion_iniciada\", \"completado\", \"credenciales_invalidas\", \"no_permitido\"];\nif (ok && conocidos.includes(data.estado)) {\n  salida = \"resultado\";\n  const r = { ok: true, estado: data.estado, paso: String(data.paso || \"\"), decision: String(data.decision || \"\") };\n  // Sesión de Crediviva: solo viaja hacia el workflow, que la guarda en memoria. Nunca se imprime.\n  if (typeof data.authKey === \"string\" && data.authKey) r.authKey = data.authKey;\n  $output.set(\"resultado\", r);\n} else {\n  $output.set(\"error\", { ok: false, estado: \"error\", code: \"HTTP_\" + status, message: \"No se pudo iniciar sesión.\" });\n}\n$context.set(\"salida\", salida);",
        "memoryVersion": "v2"
      }
    },
