      "configuration": {
        "title": "Elegir ambiente",
        "content": "// ================== ELIGE AQUÍ EL AMBIENTE ==================\n//  \"staging\"    → pruebas  (secretos CREDIVIVA_*_STAGING)\n//  \"production\" → clientes reales (secretos CREDIVIVA_*_PRODUCTION)\nconst AMBIENTE = \"staging\";\n// País de operación (Panamá es el único activo en esta fase)\nconst PAIS = \"PA\";\n// ============================================================\nif (AMBIENTE === \"staging\" || AMBIENTE === \"production\") {\n  $output.set(\"ambiente\", { ambiente: AMBIENTE, countryCode: PAIS });\n  $context.set(\"valido\", \"si\");\n} else {\n  $output.set(\"error\", { ok: false, code: \"CONFIGURACION\", message: \"AMBIENTE debe ser staging o production\" });\n  $context.set(\"valido\", \"no\");\n}",
        "memoryVersion": "v2"
      }
    },
