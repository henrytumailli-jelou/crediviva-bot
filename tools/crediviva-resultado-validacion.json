      ],
      "configuration": {
        "title": "Preparar solicitud",
        "content": "function inp(k, d) {\n  try {\n    const v = $input.get(k);\n    return v === undefined || v === null || v === \"\" ? d : v;\n  } catch (e) {\n    return d;\n  }\n}\nasync function secreto(nombre) {\n  try {\n    return String((await $secret.get(nombre)) || \"\");\n  } catch (e) {\n    return \"\";\n  }\n}\nlet fallo = \"\";\nconst fnKey = (await secreto(\"JELOU_FN_INVOKE_KEY\"));\nif (fnKey.length < 8) fallo = \"Falta el secreto JELOU_FN_INVOKE_KEY.\";\nconst nonce = String(inp(\"nonce\", \"\")).trim();\nif (!fallo && nonce.length < 50) fallo = \"Falta la sesión de validación.\";\n$context.set(\"fnKey\", fnKey);\n$context.set(\"body\", JSON.stringify({ n: nonce }));\nif (fallo) {\n  $output.set(\"error\", { ok: false, code: \"CONFIGURACION\", message: fallo });\n}\n$context.set(\"prepOk\", fallo ? \"no\" : \"si\");",
        "memoryVersion": "v2"
      }
    },
    {
      "id": "6uLigRtO8A4EXKe35n35E",
      "type": "END",
      "title": "Fin: Error técnico",
