    {
      "id": "nW_DZ_dKHowMWA-Mkhqsl",
      "type": "CODE",
      "title": "Interpretar respuesta",
      "position": [
        1780,
        50
      ],
      "configuration": {
        "title": "Interpretar respuesta",
        "content": "const res = $context.getHttpResponse(\"resultadoResponse\");\nlet status = 0;\ntry {\n  status = Number(typeof res?.status === \"function\" ? res.status() : res?.status) || 0;\n} catch (e) {\n  status = 0;\n}\nlet data = {};\ntry {\n  data = typeof res?.json === \"function\" ? await res.json() : (res?.json ?? res?.data ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nif (!data || typeof data !== \"object\") data = {};\nconst ok = status >= 200 && status < 300;\nconst mensaje = String(data.message ?? data.error?.message ?? data.detail ?? \"\");\nconst codigo = String(data.code ?? data.errorCode ?? data.error?.code ?? (typeof data.error === \"string\" ? data.error : \"\"));\n$utils.logger.log(\"resultadoResponse\", JSON.stringify({ status, codigo }));\nlet salida = \"error\";\nif (ok && data.authenticated === true && typeof data.sessionToken === \"string\" && data.sessionToken) {\n  salida = \"autenticado\";\n  $output.set(\"autenticado\", { ok: true, sessionToken: data.sessionToken, expiresInSeconds: Number(data.expiresInSeconds || 1500) });\n} else if (ok) {\n  salida = \"no_autenticado\";\n  $output.set(\"no_autenticado\", { ok: false, reason: String(data.reason || \"incomplete\") });\n} else {\n  $output.set(\"error\", { ok: false, code: \"HTTP_\" + status, message: mensaje || \"No se pudo consultar el resultado.\" });\n}\n$context.set(\"salida\", salida);",
        "memoryVersion": "v2"
      }
    },
