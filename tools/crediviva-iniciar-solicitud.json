    {
      "id": "FGfhMR0bPjleylrgI_S2b",
      "title": "Preparar solicitud",
      "type": "CODE",
      "position": [
        520,
        50
      ],
      "configuration": {
        "title": "Preparar solicitud",
        "content": "function inp(k, d) {\n  try {\n    const v = $input.get(k);\n    return v === undefined || v === null || v === \"\" ? d : v;\n  } catch (e) {\n    return d;\n  }\n}\nlet fallo = \"\";\nconst ambiente = String(inp(\"ambiente\", \"\")).trim().toLowerCase();\nif (ambiente !== \"staging\" && ambiente !== \"production\") {\n  fallo = \"El ambiente debe ser staging o production (recibido: \" + ambiente + \").\";\n}\nconst userId = String(inp(\"userId\", \"\")).trim();\nif (!fallo && !userId) fallo = \"Falta el usuario.\";\n// La sesión de Crediviva nunca se imprime.\nconst authKey = String(inp(\"authKey\", \"\")).trim();\nif (!fallo && (authKey.length < 10 || authKey.includes(\"{{\"))) fallo = \"Falta la sesión de Crediviva.\";\nconst body = { userId, ambiente, authKey };\nconst botId = String(inp(\"botId\", \"\")).trim();\nif (botId && !botId.includes(\"{{\")) body.botId = botId;\nconst paso = String(inp(\"paso\", \"\")).trim();\nif (paso && !paso.includes(\"{{\")) body.paso = paso;\n$context.set(\"body\", JSON.stringify(body));\nif (fallo) $output.set(\"error\", { ok: false, estado: \"error\", code: \"CONFIGURACION\", message: fallo });\n$context.set(\"prepOk\", fallo ? \"no\" : \"si\");",
        "memoryVersion": "v2"
      }
    },
    {
      "id": "gzP_YxOQVAQfOP0Ta7hm7",
      "title": "Fallo técnico",
      "type": "CODE",
      "position": [
        2200,
        410
      ],
      "configuration": {
        "title": "Fallo técnico",
        "content": "$output.set(\"error\", {\n  ok: false,\n  estado: \"error\",\n  code: \"TECNICO\",\n  message: \"No fue posible comunicarse con el servicio de solicitud de Crediviva.\",\n});",
        "memoryVersion": "v2"
      }
    },
    {
      "id": "iWkXVWk9nTlGpkX_7huw5",
      "title": "Start",
      "type": "START",
      "position": [
        818,
        338
      ]
    },
    {
      "id": "sL6123IRKhJ3rocyRo4Wf",
      "title": "Interpretar respuesta",
      "type": "CODE",
      "position": [
        1780,
        50
      ],
      "configuration": {
        "title": "Interpretar respuesta",
        "content": "const res = $context.getHttpResponse(\"fnResponse\");\nlet status = 0;\ntry {\n  status = Number(typeof res?.status === \"function\" ? res.status() : res?.status) || 0;\n} catch (e) {\n  status = 0;\n}\nlet data = {};\ntry {\n  data = typeof res?.json === \"function\" ? await res.json() : (res?.json ?? res?.data ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nif (!data || typeof data !== \"object\") data = {};\nconst ok = status >= 200 && status < 300;\n$utils.logger.log(\"fnResponse\", JSON.stringify({ status, estado: data.estado }));\nlet salida = \"error\";\nif (ok && data.estado === \"pendiente\" && typeof data.url === \"string\" && data.url) {\n  salida = \"enlace\";\n  $output.set(\"enlace\", { ok: true, estado: \"enlace\", url: data.url, ttlSeconds: Number(data.ttlSeconds) || 1800, message: \"Envía esta url al cliente como webview.\" });\n} else {\n  $output.set(\"error\", { ok: false, estado: \"error\", code: \"HTTP_\" + status, message: \"No se pudo preparar la solicitud de crédito.\" });\n}\n$context.set(\"salida\", salida);",
        "memoryVersion": "v2"
      }
    },
