      "configuration": {
        "title": "Llamar servicio de solicitud",
        "method": "POST",
        "url": "https://crediviva-onboarding.fn.jelou.ai/solicitud-iniciar",
        "output": "fnResponse",
        "settings": {
          "sslCertificate": true,
          "timeout": 20000
        },
        "authentication": {
