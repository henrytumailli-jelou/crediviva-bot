    {
      "id": "iRQrYZsTWOEjaFH50dNuo",
      "title": "Llamar servicio de registro",
      "type": "HTTP",
      "position": [
        1360,
        50
      ],
      "configuration": {
        "title": "Llamar servicio de registro",
        "method": "POST",
        "url": "https://crediviva-onboarding.fn.jelou.ai/registro-estado",
        "output": "fnResponse",
        "settings": {
          "sslCertificate": true,
          "timeout": 20000
        },
        "authentication": {
          "type": "bearer",
          "enabled": true,
          "token": "{{$secret.JELOU_FN_INVOKE_KEY}}"
        },
        "headers": [
          {
            "id": "Content-Type",
            "key": "Content-Type",
            "value": "application/json",
            "enabled": true
          },
          {
            "id": "Accept",
            "key": "Accept",
            "value": "application/json",
            "enabled": true
          }
        ],
        "body": {
          "type": "application/json",
          "enabled": true,
          "content": "{{$context.body}}"
        }
      }
    },
    {
      "id": "jTbEkg7MACn56jURd6vIi",
      "title": "Fallo técnico",
      "type": "CODE",
      "position": [
        2200,
