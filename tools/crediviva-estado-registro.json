      ]
    },
    {
      "id": "Z-s9TY-_3WK326d3488mq",
      "title": "Interpretar respuesta",
      "type": "CODE",
      "position": [
        1780,
        50
      ],
      "configuration": {
        "title": "Interpretar respuesta",
        "content": "const res = $context.getHttpResponse(\"fnResponse\");\nlet status = 0;\ntry {\n  status = Number(typeof res?.status === \"function\" ? res.status() : res?.status) || 0;\n} catch (e) {\n  status = 0;\n}\nlet data = {};\ntry {\n  data = typeof res?.json === \"function\" ? await res.json() : (res?.json ?? res?.data ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nif (!data || typeof data !== \"object\") data = {};\nconst ok = status >= 200 && status < 300;\n$utils.logger.log(\"fnResponse\", JSON.stringify({ status, estado: data.estado }));\nconst conocidos = [\"cuenta_creada\", \"sesion_iniciada\", \"completado\", \"app\", \"cancelado\", \"pendiente\", \"sin_sesion\"];\nlet salida = \"error\";\nif (ok && conocidos.includes(data.estado)) {\n  salida = \"resultado\";\n  const resultado = { ok: true, estado: data.estado, paso: String(data.paso || \"\"), decision: String(data.decision || \"\"), origen: String(data.origen || \"\"), ambiente: String(data.ambiente || \"\"), mensaje: String(data.mensaje || \"\"), monto: Number(data.monto) || 0 };\n  // Sesión de Crediviva: solo viaja hacia el workflow, que la guarda en memoria. Nunca se imprime.\n  if (typeof data.authKey === \"string\" && data.authKey) resultado.authKey = data.authKey;\n  $output.set(\"resultado\", resultado);\n} else {\n  $output.set(\"error\", { ok: false, estado: \"error\", code: \"HTTP_\" + status, message: \"No se pudo consultar el registro.\" });\n}\n$context.set(\"salida\", salida);",
        "memoryVersion": "v2"
      }
    }
  ],
