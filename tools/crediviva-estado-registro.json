      ],
      "configuration": {
        "title": "Fallo técnico",
        "content": "$output.set(\"error\", {\n  ok: false,\n  code: \"TECNICO\",\n  message: \"No fue posible comunicarse con el servicio de registro de Crediviva.\",\n});",
        "memoryVersion": "v2"
      }
