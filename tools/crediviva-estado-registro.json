  "nodes": [
    {
      "id": "3QAU1k4CnYjaUKENoqMj2",
      "title": "Preparar solicitud",
      "type": "CODE",
      "position": [
        520,
        50
      ],
      "configuration": {
        "title": "Preparar solicitud",
        "content": "function inp(k, d) {\n  try {\n    const v = $input.get(k);\n    return v === undefined || v === null || v === \"\" ? d : v;\n  } catch (e) {\n    return d;\n  }\n}\nlet fallo = \"\";\nconst userId = String(inp(\"userId\", \"\")).trim();\nif (!userId) fallo = \"Falta el usuario.\";\nconst body = { userId };\nconst phone = String(inp(\"phone\", \"\")).trim();\nif (phone && !phone.includes(\"{{\")) body.phone = phone;\n$context.set(\"body\", JSON.stringify(body));\nif (fallo) $output.set(\"error\", { ok: false, code: \"CONFIGURACION\", message: fallo });\n$context.set(\"prepOk\", fallo ? \"no\" : \"si\");",
        "memoryVersion": "v2"
      }
    },
    {
      "id": "dwv8jWiIJ0-xRLA9HDQpR",
      "title": "¿Solicitud lista?",
      "type": "CONDITIONAL",
      "position": [
        940,
        50
      ],
      "configuration": {
        "title": "¿Solicitud lista?",
        "conditions": [
          {
            "id": "cond_prep_ok",
            "name": "Lista para enviar",
            "operator": "and",
            "terms": [
              {
                "value1": "{{$context.prepOk}}",
                "operator": "equal",
                "value2": "si"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "eDbqKaWmmqSgjieB_pM8H",
      "title": "Fin: resultado",
      "type": "END",
      "position": [
        2620,
        50
      ],
      "configuration": {
        "title": "Fin: resultado",
        "outputId": "yAL6VBwC1JpYmDkQVyWBc"
      }
    },
    {
      "id": "EUyQ5lemAT8IuL452nQMb",
      "title": "¿Cuál es el resultado?",
      "type": "CONDITIONAL",
      "position": [
        2200,
        410
      ],
      "configuration": {
        "title": "¿Cuál es el resultado?",
        "conditions": [
          {
            "id": "cond_resultado",
            "name": "resultado",
            "operator": "and",
