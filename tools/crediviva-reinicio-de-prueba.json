          "enabled": true,
          "content": "{{$context.body}}"
        }
      }
    },
    {
      "id": "cDT_hS_DfNjC8sm94Q3Rn",
      "title": "Interpretar respuesta",
      "type": "CODE",
      "position": [
        1780,
        50
      ],
      "configuration": {
        "title": "Interpretar respuesta",
        "content": "const res = $context.getHttpResponse(\"fnResponse\");\nlet status = 0;\ntry {\n  status = Number(typeof res?.status === \"function\" ? res.status() : res?.status) || 0;\n} catch (e) {\n  status = 0;\n}\nlet data = {};\ntry {\n  data = typeof res?.json === \"function\" ? await res.json() : (res?.json ?? res?.data ?? {});\n} catch (e) {\n  data = {};\n}\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\nif (!data || typeof data !== \"object\") data = {};\nconst ok = status >= 200 && status < 300;\n$utils.logger.log(\"fnResponse\", JSON.stringify({ status, estado: data.estado }));\nlet salida = \"error\";\nif (ok && (data.estado === \"reiniciado\" || data.estado === \"no_permitido\")) {\n  salida = \"resultado\";\n  $output.set(\"resultado\", { ok: true, estado: data.estado });\n} else {\n  $output.set(\"error\", { ok: false, estado: \"error\", code: \"HTTP_\" + status, message: \"No se pudo reiniciar la prueba.\" });\n}\n$context.set(\"salida\", salida);",
        "memoryVersion": "v2"
      }
    },
    {
      "id": "FNG1fUMwP3nwMozybAW21",
      "title": "Preparar solicitud",
      "type": "CODE",
      "position": [
        520,
        50
      ],
      "configuration": {
        "title": "Preparar solicitud",
        "content": "function inp(k, d) {\n  try {\n    const v = $input.get(k);\n    return v === undefined || v === null || v === \"\" ? d : v;\n  } catch (e) {\n    return d;\n  }\n}\nlet fallo = \"\";\nconst ambiente = String(inp(\"ambiente\", \"\")).trim().toLowerCase();\nif (ambiente !== \"staging\" && ambiente !== \"production\") fallo = \"El ambiente debe ser staging o production (recibido: \" + ambiente + \").\";\nconst userId = String(inp(\"userId\", \"\")).trim();\nif (!fallo && !userId) fallo = \"Falta el usuario.\";\nconst body = { userId, ambiente };\nconst phone = String(inp(\"phone\", \"\")).trim();\nif (phone && !phone.includes(\"{{\")) body.phone = phone;\n$context.set(\"body\", JSON.stringify(body));\nif (fallo) $output.set(\"error\", { ok: false, estado: \"error\", code: \"CONFIGURACION\", message: fallo });\n$context.set(\"prepOk\", fallo ? \"no\" : \"si\");",
        "memoryVersion": "v2"
      }
    },
    {
