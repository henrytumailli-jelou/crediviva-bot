      "configuration": {
        "title": "Llamar servicio de reinicio",
        "method": "POST",
        "url": "https://crediviva-onboarding.fn.jelou.ai/prueba-reiniciar",
        "output": "fnResponse",
        "settings": {
          "sslCertificate": true,
          "timeout": 20000
        },
        "authentication": {
          "type": "bearer",
          "enabled": true,
          "token": "{{$secret.JELOU_FN_INVOKE_KEY}}"
        },
        "headers": [
